-- =====================================================
-- Consulta 4: Consolidado por canal (UNION ALL)
-- Clasifica ventas en canales ficticios y totaliza
-- =====================================================

SELECT DISTINCT id_cliente 
FROM ventas 
ORDER BY id_cliente;

SELECT 
    canal, 
    SUM(total) AS total_canal
FROM (
    -- Subconsulta 1: Canal Online (clientes web)
    SELECT 
        v.id_venta,
        (v.cantidad * v.precio_unitario) AS total, 
        'Online' AS canal
    FROM ventas v
    WHERE v.id_cliente IN (1, 2, 3)
    UNION ALL
    -- Subconsulta 2: Canal Presencial (clientes en tienda)
    SELECT 
        v.id_venta,
        (v.cantidad * v.precio_unitario) AS total, 
        'Presencial' AS canal
    FROM ventas v
    WHERE v.id_cliente NOT IN (1, 2, 3)
) AS consolidado
GROUP BY canal;